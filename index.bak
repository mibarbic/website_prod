      ]
    },
    {
      title: 'Kia Forum — EV6 Digital Experience',
      category: 'Digital / Game · 2023',
      slides: [
        { label: 'Interactive In-Venue Game',  desc: 'E-learning videogame deployed at the Kia Forum to promote the flagship EV6 vehicle. Art-directed and produced end-to-end — balancing brand education with playable engagement for guests passing through the venue.' },
        { label: 'Art Direction',              desc: 'Visual system for the in-game world: vehicle hero treatment, environment styling, and UI surfaces tied to Kia brand standards while reading as a playable space.' },
        { label: 'In-Venue Deployment',        desc: 'Hardware-integrated install at the Kia Forum. Built for repeated guest play with reset behavior, attract-loop visuals, and venue-appropriate session length.' },
        { label: 'Production & Handoff',       desc: 'Production pipeline coordinating art, motion, and engineering handoffs. Final asset prep and on-site QA for venue rollout.' }
      ]
    },
    {
      title: 'Odoo — Brand & Production System',
      category: 'Motion / Brand Systems · 2022–23',
      slides: [
        { label: 'Unified Motion Language',     desc: 'Video bumpers unified across Odoo e-learning content and promotional material — one motion language carried across two distinct content streams.' },
        { label: 'E-Learning Motion Package',   desc: 'Motion graphics built specifically for the e-learning surface — designed to template across many course episodes without losing brand integrity at scale.' },
        { label: 'Livestream Production Kit',   desc: 'Livestream graphic kits supporting Odoo conferences and product demos. Lower-thirds, broadcast bugs, and transition packages built for live-control operation.' },
        { label: 'Conference & Demo Surfaces',  desc: 'Supporting graphic surfaces for live conference and demo settings — coordinated with the bumper and livestream systems for end-to-end visual consistency.' }
      ]
    },
    {
      title: 'Arminda Cloud Monitoring',
      category: 'App / UX / Brand · 2022',
      slides: [
        { label: 'Brand System (NDA-recreated)', desc: 'Shipped product. Name and product imagery recreated under freelance NDA — visual divergence from the live product is intentional. Full brand system: identity, type, color, voice.' },
        { label: 'App UX Flows',                 desc: 'Core UX flows for the cloud monitoring app — onboarding, dashboard, alerting, and account surfaces. Designed for operator clarity over decoration.' },
        { label: 'Visual System & Components',   desc: 'Design system underpinning the app: components, layouts, dark/light modes, and data-density treatments tuned for monitoring contexts.' },
        { label: 'Marketing Surface',            desc: 'Marketing surface tying brand identity to product UI — landing pages, feature cards, and acquisition surfaces aligned to the in-app experience.' }
      ]
    }
  ];

  var modalEl    = document.getElementById('projectModal');
  var carouselEl = document.getElementById('projectCarousel');
  var innerEl    = document.getElementById('modal-carousel-inner');
  var thumbsEl   = document.getElementById('modal-thumbs');
  var descEl     = document.getElementById('modal-slide-desc');
  var titleEl    = document.getElementById('modal-project-title');
  var catEl      = document.getElementById('modal-category-label');
  var refsEl     = document.getElementById('modal-references');
  var refsListEl = document.getElementById('modal-references-list');

  function setDesc(project, idx) {
    var s = project.slides[idx];
    descEl.innerHTML = '<div class="mono">' + s.label + '</div><p>' + s.desc + '</p>';
  }

  function openProject(idx) {
    var p = projects[idx];
    titleEl.textContent = p.title;
    catEl.textContent   = p.category;

    // Build carousel slides
    innerEl.innerHTML = '';
    p.slides.forEach(function (s, i) {
      var item = document.createElement('div');
      item.className = 'carousel-item' + (i === 0 ? ' active' : '');
      var coverStyle = s.img ? ' has-cover" style="background-image:url(\'' + s.img + '\')' : '';
      item.innerHTML = '<div class="modal-slide-placeholder' + coverStyle + '"><div class="modal-slide-placeholder-label">' + s.label + '</div></div>';
      innerEl.appendChild(item);
    });

    // Build thumbnails
    thumbsEl.innerHTML = '';
    p.slides.forEach(function (s, i) {
      var t = document.createElement('div');
      t.className = 'modal-thumb' + (i === 0 ? ' active' : '');
      t.setAttribute('data-bs-target', '#projectCarousel');
      t.setAttribute('data-bs-slide-to', String(i));
      t.innerHTML = '<span>' + s.label + '</span>';
      t.addEventListener('click', function () {
        bootstrap.Carousel.getOrCreateInstance(carouselEl).to(i);
      });
      thumbsEl.appendChild(t);
    });

    setDesc(p, 0);

    // Build references footer (hidden when project has none)
    refsListEl.innerHTML = '';
    if (p.references && p.references.length) {
      p.references.forEach(function (r) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = r.url;
        a.textContent = r.label;
        if (r.url && r.url !== '#') {
          a.target = '_blank';
          a.rel = 'noopener';
        }
        li.appendChild(a);
        refsListEl.appendChild(li);
      });
      refsEl.hidden = false;
    } else {
      refsEl.hidden = true;
    }

    // Sync description + thumbnails on slide change
    carouselEl.addEventListener('slid.bs.carousel', function handler(e) {
      setDesc(p, e.to);
      thumbsEl.querySelectorAll('.modal-thumb').forEach(function (t, i) {
        t.classList.toggle('active', i === e.to);
      });
    });
    modalEl.addEventListener('hidden.bs.modal', function cleanup() {
      carouselEl.removeEventListener('slid.bs.carousel', handler);
      modalEl.removeEventListener('hidden.bs.modal', cleanup);
    }, { once: true });

    // Reset carousel to slide 0 then show
    var bsCarousel = bootstrap.Carousel.getOrCreateInstance(carouselEl, { ride: false, wrap: true });
    bsCarousel.to(0);
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
  }

  document.querySelectorAll('.work-card[data-project]').forEach(function (card) {
    card.addEventListener('click', function (e) {
      e.preventDefault();
      openProject(parseInt(card.getAttribute('data-project'), 10));
    });
  });
})();
</script>
