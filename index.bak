<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  var h1 = document.querySelector('.hero h1');
  if (!h1) return;

  var scrambleFonts = [
    'Georgia, serif',
    'Impact, fantasy',
    "'Courier New', monospace",
    'Arial, sans-serif',
    'Palatino, serif',
    "'Times New Roman', serif",
    'Verdana, sans-serif',
    'Trebuchet MS, sans-serif',
    "'Comic Sans MS', cursive",
    'system-ui, sans-serif'
  ];

  var STAGGER   = 100;  // ms between each character appearing
  var INTERVAL  = 300; // ms per font cycle
  var CYCLES    = 1;    // font changes before settling

  // Immediately hide everything in the hero below the h1
  var holdEls = Array.prototype.slice.call(
    document.querySelectorAll('.hero .tagline, .hero .hero-meta')
  );
  holdEls.forEach(function (el) {
    el.style.setProperty('opacity', '0', 'important');
    el.style.setProperty('transform', 'translateY(28px)', 'important');
    el.style.setProperty('transition', 'none', 'important');
  });

  var triggered = false;

  // Wrap "that you can trust." words in individual hidden spans for staggered reveal
  function wrapSecondLine() {
    var children = Array.prototype.slice.call(h1.childNodes);
    var brIdx = -1;
    for (var i = 0; i < children.length; i++) {
      if (children[i].nodeName === 'BR') { brIdx = i; break; }
    }
    if (brIdx === -1) return [];
    var words = [];
    var secondNodes = [];
    for (var j = brIdx + 1; j < children.length; j++) secondNodes.push(children[j]);
    secondNodes.forEach(function (node) {
      if (node.nodeType === 3) {
        var parts = node.textContent.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        parts.forEach(function (part) {
          if (/^\s+$/.test(part)) {
            frag.appendChild(document.createTextNode(part));
          } else if (part) {
            var span = document.createElement('span');
            span.style.cssText = 'opacity:0;transform:translateX(-12px);transition:opacity 0.6s cubic-bezier(0.2,0.8,0.2,1),transform 0.6s cubic-bezier(0.2,0.8,0.2,1);display:inline-block;line-height:inherit;font-size:inherit;';
            span.textContent = part;
            words.push(span);
            frag.appendChild(span);
          }
        });
        node.parentNode.replaceChild(frag, node);
      }
    });
    return words;
  }

  // Wrap each character of "Creative," in its own span, hidden initially
  function wrapFirstLine() {
    var chars = [];
    var children = Array.prototype.slice.call(h1.childNodes);
    for (var n = 0; n < children.length; n++) {
      var node = children[n];
      if (node.nodeName === 'BR') break;
      if (node.nodeType === 3) {
        var text = node.textContent;
        var frag = document.createDocumentFragment();
        for (var i = 0; i < text.length; i++) {
          var span = document.createElement('span');
          span.textContent = text[i];
          span.style.cssText = 'opacity:0;line-height:inherit;font-size:inherit;';
          frag.appendChild(span);
          chars.push(span);
        }
        node.parentNode.replaceChild(frag, node);
      }
    }
    return chars;
  }

  function runScramble() {
    if (triggered) return;
    triggered = true;

    var secondWords = wrapSecondLine();
    var chars   = wrapFirstLine();
    var visible = chars.filter(function (s) { return s.textContent.trim().length > 0; });

    visible.forEach(function (span, i) {
      setTimeout(function () {
        // Reveal character and immediately start on a random font
        span.style.opacity = '1';
        span.style.fontFamily = scrambleFonts[Math.floor(Math.random() * scrambleFonts.length)];
        var count = 1;
        var iv = setInterval(function () {
          count++;
          if (count > CYCLES) {
            clearInterval(iv);
            span.style.fontFamily = "'Shippori Antique B1', serif";
          } else {
            span.style.fontFamily = scrambleFonts[Math.floor(Math.random() * scrambleFonts.length)];
          }
        }, INTERVAL);
      }, i * STAGGER);
    });

    // After last character has fully settled, reveal everything below
    var totalMs = (visible.length - 1) * STAGGER + CYCLES * INTERVAL + 200;
    setTimeout(function () {
      var LINE2_STAGGER = 120;
      secondWords.forEach(function (w, i) {
        setTimeout(function () {
          w.style.opacity = '1';
          w.style.transform = 'translateX(0)';
        }, i * LINE2_STAGGER);
      });

      holdEls.forEach(function (el) {
        el.style.setProperty('transition', 'opacity 0.9s ease, transform 0.9s ease', 'important');
        el.style.setProperty('transform', 'translateY(0)', 'important');
        requestAnimationFrame(function () {
          el.style.setProperty('opacity', '1', 'important');
          setTimeout(function () {
            el.style.removeProperty('opacity');
            el.style.removeProperty('transform');
            el.style.removeProperty('transition');
          }, 1000);
        });
      });
    }, totalMs);
  }

  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) { runScramble(); obs.unobserve(entry.target); }
    });
  }, { threshold: 0.12 });
  obs.observe(h1);
})();
</script>
<script>
  // Global top-to-bottom animation sequencer
  (function () {
    var GAP = 150;
    var _queue = [];
    var _flushing = false;

    function _flush() {
      if (!_queue.length) { _flushing = false; return; }
      _flushing = true;
      _queue.shift().fn();
      setTimeout(_flush, GAP);
    }

    window._revealQueue = {
      push: function (top, fn) {
        var i = 0;
        while (i < _queue.length && _queue[i].top <= top) i++;
        _queue.splice(i, 0, { top: top, fn: fn });
        if (!_flushing) _flush();
      }
    };
  })();

  // Word-by-word left-to-right reveal
  (function () {
    var STAGGER = 45;
    var targets = document.querySelectorAll('h2.section-title, .tagline, .about-body p');

    function wrapWordsInNode(node, words) {
      if (node.nodeType === 3) {
        var parts = node.textContent.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        parts.forEach(function (part) {
          if (/^\s+$/.test(part)) {
            frag.appendChild(document.createTextNode(part));
          } else if (part) {
            var span = document.createElement('span');
            span.className = 'word';
            span.textContent = part;
            words.push(span);
            frag.appendChild(span);
          }
        });
        node.parentNode.replaceChild(frag, node);
      } else if (node.nodeType === 1) {
        Array.prototype.slice.call(node.childNodes).forEach(function (child) {
          wrapWordsInNode(child, words);
        });
      }
    }

    if (!('IntersectionObserver' in window)) {
      targets.forEach(function (el) {
        var words = [];
        Array.prototype.slice.call(el.childNodes).forEach(function (c) { wrapWordsInNode(c, words); });
        words.forEach(function (w) { w.classList.add('in'); });
      });
      return;
    }

    var wordIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var top = el.getBoundingClientRect().top;
        window._revealQueue.push(top, function () {
          el._words.forEach(function (w, i) {
            setTimeout(function () { w.classList.add('in'); }, i * STAGGER);
          });
        });
        wordIO.unobserve(el);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

    targets.forEach(function (el) {
      el.classList.remove('reveal', 'delay-1', 'delay-2', 'delay-3', 'delay-4');
      var words = [];
      Array.prototype.slice.call(el.childNodes).forEach(function (c) { wrapWordsInNode(c, words); });
      el._words = words;
      wordIO.observe(el);
    });
  })();
</script>
<script>
  // Scroll reveal — minimal, smooth
  (function () {
    var reveals = document.querySelectorAll('.reveal');
    var glows = document.querySelectorAll('[data-glow]');

    if (!('IntersectionObserver' in window)) {
      reveals.forEach(function (el) { el.classList.add('in'); });
      glows.forEach(function (el) { el.classList.add('lit'); });
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var top = el.getBoundingClientRect().top;
        window._revealQueue.push(top, function () { el.classList.add('in'); });
        io.unobserve(el);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function (el) { io.observe(el); });

    var glowIO = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('lit');
          glowIO.unobserve(entry.target);
        }
      });
    }, { threshold: 0, rootMargin: '200px 0px 200px 0px' });
    glows.forEach(function (el) { glowIO.observe(el); });
  })();
</script>
