      slides: [
        { label: 'Premier Brand Visibility — Three Years Running', img: 'img/works/asw26_telluride_viz.png', desc: 'NBA All-Star Weekend is one of Kia\'s premier brand visibility moments. Owned the activation creative across 2023, 2024, and 2025 — guest-oriented designs leveraging both the Kia brand and the NBA style guide. Deliverables span physical fabrication, digital content, and motion graphics: disciplines that would typically require multiple specialists.' },
        { label: 'Creative Direction & 3D Pitch Concepts', desc: 'Creative direction and 3D visualization of activation concepts for client pitch decks. Render-to-build fidelity so what gets approved is what shows up on site.' },
        { label: 'Activation Graphics Suite',              desc: 'Wall graphics, signage, bespoke vehicle wraps, and flagship-specific motion graphics across activation spaces. Each year layers in updated NBA-compliant treatment without losing the Kia brand throughline.' },
        { label: 'Vendor Production Documentation',        desc: 'Full vendor production documentation and on-site guidance — from print specs to install instructions — tying the creative vision to a fabricated reality.' }
      ],
      references: [
        { label: '2025 — NBA ASW Activation', url: 'https://www.linkedin.com/posts/kia-america_nbaallstar-kiaskills-activity-7298023633988239363-YBLc' },
        { label: '2024 — NBA ASW Activation', url: 'https://www.linkedin.com/posts/kia-america_kiaev9-kiaskillschallenge-nbaallstar-activity-7165800677380665345-IPqW' },
        { label: '2023 — NBA ASW Activation', url: 'https://www.linkedin.com/posts/kia-america_nbaallstar-kiatelluridexpro-kiadriveway-activity-7033480544365547520-LZ0F' }
      ]
    },
    {
      title: 'NBA Season-Long Partnership',
      category: 'Experiential / UI · UX / Brand Systems · 2024–25',
      slides: [
        { label: 'Highest-Volume Workstream → All NBA Arenas',  img: 'img/works/option03__ORLKCBackWallMockup_v01mb.png', desc: 'Highest-volume recurring workstream of the year, spanning the full NBA season with continuous deliverable cycles across NBA arenas. Vehicle installations and guest experiences shape brand perception and drive registrations → site by site, week by week.' },
        { label: 'In-Arena Digital Game! UI/UX',              img: 'img/works/NBA_SL_2025_Mobile.png',                  desc: 'UI/UX design and creative direction for the in-arena digital game experience. Full asset preparation and direction handed to development vendors who build directly from my deliverables. A responsibility that extends well beyond traditional graphic design into art direction and product design.' },
        { label: '3D Vehicle Installation Visualization',      desc: 'Photoreal 3D visualization of vehicle installations and guest experience flows for arena activations. Used for stakeholder alignment and to anchor vendor production specs before install.' },
        { label: 'Vendor Specs + Regional Dealer Lists',       desc: 'Vendor guidance on compliant material specifications and installation requirements for arena-specific sites. Production of regional dealer lists for vehicle display events tied to each market\'s activation.' }
      ]
    },
    {
      title: 'WNBA All-Star Weekend',
      category: 'Experiential · 2025',
      slides: [
        { label: 'Premier Brand Moment — 2025',         desc: 'Another of Kia\'s premier brand visibility moments. WNBA All-Star Weekend deliverables span physical fabrication, digital content, and motion graphics — disciplines that would typically require multiple specialists, owned end-to-end here.' },
        { label: 'Bespoke Vehicle Wrap',                desc: 'Custom vehicle wrap built for the All-Star activation — graphic system anchored in WNBA-compliant style while staying on-brand for Kia.' },
        { label: 'Creative Direction & 3D Pitch',       desc: 'Creative direction and 3D visualization of activation concepts for the client pitch. WNBA-compliant graphics developed in parallel with vehicle and environmental treatments.' },
        { label: 'Activation Graphics & Production',    desc: 'Wall graphics, signage, and flagship-specific motion graphics for the activation site, paired with vendor production documentation for install.' }
      ],
      references: [
        { label: '2025 — WNBA ASW Vehicle Wrap', url: 'https://www.linkedin.com/posts/the-true-all-stars-this-weekend-were-our-ugcPost-7353091394632118272-5D6x' },
        { label: '2025 — WNBA ASW Activation',   url: 'https://www.linkedin.com/posts/kia-america_kiaskillschallenge-activity-7221197401665986560-LxeD' }
      ]
    },
    {
      title: 'Kia Forum — Permanent Install',
      category: 'Experiential / Creative Direction · 2024–25',
      slides: [
        { label: 'Strategic Creative Leadership',       desc: 'Delivered a fully realized creative vision from initial pitch through final rendering — a responsibility that extends beyond production execution into strategic creative leadership. Current design still receives incremental updates as the venue evolves.' },
        { label: '3D Concept & Stakeholder Renders',    desc: 'Creative direction for display arrangement at the Kia Forum, including 3D concept development and renderings prepared for stakeholder review and approval.' },
        { label: 'Kia Connected Home Signage',          desc: 'Design and production of Kia Connected Home signage — venue-appropriate, brand-compliant, and built to live in a permanent installation context.' },
