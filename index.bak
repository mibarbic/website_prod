<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Michelangelo Barbic — Graphic Designer / Brand, Digital & Motion</title>
<meta name="description" content="Portfolio of Michelangelo Barbic — Graphic Designer based in Los Angeles. Brand, digital, print, and motion.">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Antique+B1&family=Do+Hyeon&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F2F0EB;
    --ink: #0F0F0F;
    --muted: #2e2e2e;
    --line: #D8D5CE;
    --accent: #FF8A3D;
    --accent-rgb: 255, 138, 61;
    --card: #EAE7E0;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Shippori Antique B1', serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    margin: 0;
  }

  /* Type utilities (´• ω •`) */
  .mono {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .section-number {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* NAV ~(>_<~) */
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1030;
    background: rgba(242, 240, 235, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  .site-nav .brand {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 16px;
  }
  .site-nav .nav-links a {
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
    margin-left: 32px;
    font-weight: 500;
    transition: color 0.25s ease;
  }
  .site-nav .nav-links a:hover { color: var(--accent); }

  /* HERO */
  .hero {
    padding: 200px 0 120px;
    border-bottom: 1px solid var(--line);
  }
  .hero h1 {
    font-weight: 500;
    font-size: clamp(42px, 7.5vw, 112px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    margin: 24px 0 0;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--muted);
    font-weight: 300;
  }
  .hero .tagline {
    max-width: 580px;
    margin-top: 40px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink);
  }
  .hero-meta {
    display: flex;
    gap: 56px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .hero-meta .item .label { margin-bottom: 8px; }
  .hero-meta .item .value { font-size: 15px; font-weight: 500; }
  .hero-cta-row { margin-top: 40px; }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink);
    transition: color 0.25s ease, border-color 0.25s ease, gap 0.25s ease;
  }
  .hero-cta-arrow {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hero-cta:hover { color: var(--accent); border-color: var(--accent); gap: 14px; }
  .hero-cta:hover .hero-cta-arrow { transform: translateY(3px); }

  /* TRUSTED BY  	ヽ(°〇°)ﾉ */
  .trusted-by {
    padding: 90px 0 100px;
    border-bottom: 1px solid var(--line);
  }
  .trusted-by .trusted-label {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: center;
    margin-bottom: 48px;
  }
  .logo-wall {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    background: var(--line);
    gap: 1px;
    border: 1px solid var(--line);
  }
  .logo-cell {
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    padding: 20px 24px;
    color: var(--muted);
    transition: color 0.4s ease, background 0.4s ease;
  }
  .logo-cell:hover {
    color: var(--ink);
    background: #ECE9E1;
  }
  .brand-logo {
    max-width: 100%;
    max-height: 28px;
    width: auto;
    height: auto;
    display: block;
    filter: brightness(0);
  }
  @media (max-width: 1199px) {
    .logo-wall { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 575px) {
    .logo-wall { grid-template-columns: repeat(2, 1fr); }
    .logo-cell { min-height: 90px; padding: 16px; }
  }

  /* SECTIONS  	(□_□) */
  section {
    padding: 140px 0;
    border-bottom: 1px solid var(--line);
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 72px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    gap: 24px;
  }
  .section-title {
    font-weight: 500;
    font-size: clamp(32px, 4.5vw, 56px);
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin: 12px 0 0;
  }

  /* WORK GRID __φ(．．) */
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .work-placeholder {
    aspect-ratio: 4 / 3;
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .work-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(15,15,15,0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15,15,15,0.045) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .work-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    transition: border-color 0.4s ease;
  }
  .work-placeholder .placeholder-label {
    position: relative;
    z-index: 1;
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
    text-align: center;
    padding: 0 16px;
  }
  .work-card:hover .work-placeholder { transform: translateY(-4px); }
  .work-card:hover .work-placeholder::after { border-color: var(--ink); }
  .work-card:hover .placeholder-label { color: var(--accent); }
  .work-placeholder.has-cover::before { display: none; }
  .work-placeholder.has-cover .placeholder-label { display: none; }

  .work-meta {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 16px;
    row-gap: 4px;
    padding-top: 18px;
    align-items: start;
  }
  .work-title {
    grid-column: 1;
    grid-row: 1;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .work-category {
    grid-column: 1;
    grid-row: 2;
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .work-number {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: stretch;
    aspect-ratio: 1 / 1;
    border: 1.5px solid var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Do Hyeon', sans-serif;
    color: var(--ink);
    transition: border-color 0.3s ease, color 0.3s ease;
    flex-shrink: 0;
    min-width: 44px;
  }
  .work-card:hover .work-number {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ABOUT  	(－_－) zzZ */
  .about-body {
    font-size: 20px;
    line-height: 1.55;
    letter-spacing: -0.005em;
    max-width: 720px;
  }
  .about-body p + p { margin-top: 24px; }
  .about-body em {
    font-style: normal;
    color: var(--muted);
  }
  .about-portrait {
    position: sticky;
    top: 100px;
  }
  .about-portrait-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(15%);
  }

  /* EXPERIENCE 。。。ミヽ(。＞＜)ノ */
  .exp-list {
    border-top: 1px solid var(--line);
  }
  .exp-row {
    display: grid;
    grid-template-columns: 130px 1.2fr 1fr 180px;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    transition: color 0.3s ease;
  }
  .exp-row:hover { color: var(--accent); }
  .exp-year {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .exp-role {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .exp-company {
    font-size: 16px;
    color: var(--muted);
  }
  .exp-location {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    color: var(--muted);
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* SKILLS  	ヽ(*・ω・)ﾉ */
  .skill-group h4 {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .skill-list li {
    font-size: 16px;
    padding: 10px 0;
    border-bottom: 1px dotted var(--line);
    transition: color 0.3s ease;
  }
  .skill-list li:hover { color: var(--accent); }

  /* EDUCATION section  	(*꒦ິ꒳꒦ີ) */
  .edu-list { border-top: 1px solid var(--line); }
  .edu-row {
    display: grid;
    grid-template-columns: 130px 1.4fr 1.6fr 180px;
    gap: 32px;
    padding: 40px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    transition: color 0.3s ease;
  }
  .edu-row:hover { color: var(--accent); }
  .edu-year {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 3px;
    transition: color 0.3s ease;
  }
  .edu-degree { font-size: 20px; font-weight: 500; letter-spacing: -0.015em; transition: color 0.3s ease; }
  .edu-school { font-size: 14px; color: var(--muted); margin-top: 6px; transition: color 0.3s ease; }
  .edu-detail { font-size: 14px; line-height: 1.6; color: var(--muted); transition: color 0.3s ease; }
  .edu-location {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-align: right;
    padding-top: 3px;
    transition: color 0.3s ease;
  }
  .edu-row:hover .edu-year,
  .edu-row:hover .edu-degree,
  .edu-row:hover .edu-school,
  .edu-row:hover .edu-detail,
  .edu-row:hover .edu-location { color: var(--accent); }
  @media (max-width: 991px) {
    .edu-row { grid-template-columns: 1fr; gap: 12px; }
    .edu-location { text-align: left; }
  }

  /* CONTACT o(>< )o */
  .contact {
    padding: 160px 0 140px;
    background: var(--ink);
    color: var(--bg);
    border: none;
  }
  .contact .section-header { border-color: rgba(242,240,235,0.18); }
  .contact .section-number { color: rgba(242,240,235,0.5); }
  .contact h2 {
    font-size: clamp(40px, 7vw, 104px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 24px 0 0;
  }
  .contact h2 em {
    font-style: normal;
    color: rgba(242,240,235,0.45);
    font-weight: 300;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid rgba(242,240,235,0.18);
  }
  .contact-grid .label {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    color: rgba(242,240,235,0.5);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
  }
  .contact-grid a {
    color: var(--bg);
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    border-bottom: 1px solid rgba(242,240,235,0.25);
    transition: color 0.25s ease, border-color 0.25s ease;
    padding-bottom: 2px;
  }
  .contact-grid a:hover { color: var(--accent); border-color: var(--accent); }

  /* FOOTER (ノ_<。) */
  footer {
    background: var(--ink);
    color: rgba(242,240,235,0.5);
    padding: 32px 0;
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-top: 1px solid rgba(242,240,235,0.12);
  }
  footer .row { align-items: center; }

  /* ANIMATIONS ヽ(ー_ー )ノ */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .reveal.in {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal.delay-1 { transition-delay: 0.08s; }
  .reveal.delay-2 { transition-delay: 0.16s; }
  .reveal.delay-3 { transition-delay: 0.24s; }
  .reveal.delay-4 { transition-delay: 0.32s; }

  .word {
    display: inline-block;
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .word.in {
    opacity: 1;
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .word { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }

  /* RESPONSIVE ¯\_(ツ)_/¯ */
  @media (max-width: 991px) {
    .hero { padding: 150px 0 90px; }
    section { padding: 100px 0; }
    .exp-row {
      grid-template-columns: 100px 1fr;
      grid-template-rows: auto auto auto;
      gap: 8px 24px;
      padding: 24px 0;
    }
    .exp-year { grid-column: 1; grid-row: 1; }
    .exp-role { grid-column: 2; grid-row: 1; }
    .exp-company { grid-column: 2; grid-row: 2; }
    .exp-location { grid-column: 2; grid-row: 3; text-align: left; }
    .contact-grid { grid-template-columns: 1fr; gap: 24px; }
    .hero-meta { gap: 32px; }
    .section-header { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 767px) {
    .site-nav .nav-links { display: none; }
    .hero { padding: 120px 0 72px; }
    section { padding: 72px 0; }
    /* Reduce Do Hyeon label size on mobile */
    .mono,
    .section-number,
    .trusted-by .trusted-label,
    .work-placeholder .placeholder-label,
    .work-category,
    .work-number,
    .exp-year,
    .exp-location,
    .skill-group h4,
    .edu-year,
    .edu-location,
    .contact-grid .label,
    footer,
    .modal-slide-placeholder-label,
    .modal-thumb span,
    .modal-references-label { font-size: 12px; }
    /* Placeholder label inside cards: allow wrapping */
    .work-placeholder .placeholder-label { letter-spacing: 0.06em; }
  }

  /* TANGERINE AMBIENT GLOWS 🍊*/
  html, body { overflow-x: clip; }
  .hero, #about, .contact { position: relative; overflow: hidden; }
  .hero > .container,
  #about > .container,
  .contact > .container { position: relative; z-index: 2; }

  .bg-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    z-index: 0;
    filter: blur(40px);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 1.6s ease, transform 1.6s ease;
    will-change: opacity, transform;
  }
  .bg-glow.lit {
    opacity: 1;
    transform: scale(1);
  }

  .glow-hero-a {
    width: 720px; height: 720px;
    top: -220px; right: -180px;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.55) 0%, rgba(var(--accent-rgb), 0.2) 38%, transparent 72%);
  }
  .glow-hero-b {
    width: 440px; height: 440px;
    bottom: -140px; left: -120px;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.32) 0%, rgba(var(--accent-rgb), 0.1) 45%, transparent 72%);
  }
  .glow-about-a {
    width: 560px; height: 560px;
    top: 8%; right: -220px;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.28) 0%, rgba(var(--accent-rgb), 0.08) 45%, transparent 72%);
  }
  .glow-contact-a {
    width: 820px; height: 820px;
    top: -240px; right: -260px;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.55) 0%, rgba(var(--accent-rgb), 0.18) 40%, transparent 72%);
  }
  .glow-contact-b {
    width: 520px; height: 520px;
    bottom: -160px; left: -140px;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.4) 0%, rgba(var(--accent-rgb), 0.12) 45%, transparent 72%);
  }

  @media (max-width: 767px) {
    .glow-hero-a { width: 460px; height: 460px; top: -140px; right: -140px; }
    .glow-hero-b { width: 300px; height: 300px; }
    .glow-about-a { width: 380px; height: 380px; right: -160px; }
    .glow-contact-a { width: 520px; height: 520px; }
    .glow-contact-b { width: 360px; height: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-glow { transition: none; opacity: 1; transform: none; }
  }

  /* PROJECT MODAL (*°ｰ°)ﾉ */
  #projectModal .modal-content {
    background: var(--ink);
    color: var(--bg);
    border: none;
    border-radius: 0;
  }
  #projectModal .modal-header {
    border-bottom: 1px solid rgba(242,240,235,0.15);
    padding: 28px 36px;
    align-items: flex-start;
  }
  #projectModal .modal-header .mono {
    color: rgba(242,240,235,0.5);
    margin-bottom: 6px;
  }
  #projectModal .modal-header h3 {
    font-size: clamp(20px, 2.5vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
  }
  #projectModal .modal-body {
    padding: 0 36px 36px;
  }
  .modal-slide-placeholder {
    aspect-ratio: 16 / 9;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .modal-slide-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(242,240,235,0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(242,240,235,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .modal-slide-placeholder-label {
    position: relative;
    z-index: 1;
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(242,240,235,0.35);
    text-align: center;
    padding: 0 20px;
  }
  .modal-slide-placeholder.has-cover { background-size: cover; background-position: center; }
  .modal-slide-placeholder.has-cover::before { display: none; }
  .modal-slide-placeholder.has-cover .modal-slide-placeholder-label { display: none; }
  #projectModal .carousel-control-prev,
  #projectModal .carousel-control-next {
    width: 48px;
    background: rgba(15,15,15,0.6);
    opacity: 1;
    transition: background 0.2s ease;
  }
  #projectModal .carousel-control-prev:hover,
  #projectModal .carousel-control-next:hover {
    background: rgba(15,15,15,0.9);
  }
  .modal-slide-desc {
    padding: 20px 0 24px;
    border-bottom: 1px solid rgba(242,240,235,0.12);
    min-height: 90px;
  }
  .modal-slide-desc .mono {
    color: rgba(242,240,235,0.45);
    margin-bottom: 8px;
  }
  .modal-slide-desc p {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(242,240,235,0.8);
    margin: 0;
  }
  .modal-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 20px;
  }
  .modal-thumb {
    aspect-ratio: 16 / 9;
    background: #1c1c1c;
    border: 2px solid transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: border-color 0.25s ease;
  }
  .modal-thumb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(242,240,235,0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(242,240,235,0.04) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .modal-thumb span {
    position: relative;
    z-index: 1;
    font-family: 'Do Hyeon', sans-serif;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(242,240,235,0.3);
    text-align: center;
    padding: 4px 6px;
    transition: color 0.25s ease;
  }
  .modal-thumb.active {
    border-color: var(--accent);
  }
  .modal-thumb.active span,
  .modal-thumb:hover span {
    color: rgba(242,240,235,0.7);
  }
  .modal-thumb:hover {
    border-color: rgba(242,240,235,0.3);
  }
  .modal-thumb.active:hover {
    border-color: var(--accent);
  }
  .modal-references {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(242,240,235,0.12);
  }
  .modal-references-label {
    font-family: 'Do Hyeon', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(242,240,235,0.45);
    margin-bottom: 12px;
  }
  .modal-references-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .modal-references-list a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(242,240,235,0.8);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.4;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(242,240,235,0.25);
    transition: color 0.25s ease, border-color 0.25s ease, gap 0.25s ease;
  }
  .modal-references-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
    gap: 12px;
  }
  .modal-references-list a::after {
    content: '↗';
    font-size: 13px;
    line-height: 1;
    transition: transform 0.25s ease;
  }
  .modal-references-list a:hover::after {
    transform: translate(2px, -2px);
  }
  @media (max-width: 767px) {
    #projectModal .modal-header { padding: 20px; }
    #projectModal .modal-body { padding: 0 20px 24px; }
    .modal-thumbs { grid-template-columns: repeat(2, 1fr); }
    .modal-references-list { flex-direction: column; gap: 10px; }
  }

  /* Do Hyeon global size override */
  .mono,
  .section-number,
  .trusted-by .trusted-label,
  .work-placeholder .placeholder-label,
  .work-category,
  .work-number,
  .exp-year,
  .exp-location,
  .skill-group h4,
  .edu-year,
  .edu-location,
  .contact-grid .label,
  footer,
  .modal-slide-placeholder-label,
  .modal-thumb span,
  .modal-references-label { font-size: 14px; }
</style>
</head>
